    "NSUserTrackingUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit können wir dir passendere Werbung zeigen. Werbung hält das Nachtanken kostenlos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets us show ads that fit you better. Ads are what keep the fuel refill free."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos permite mostrarte anuncios más adecuados para ti. Los anuncios mantienen gratis la recarga de combustible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous permet de vous montrer des publicités plus adaptées. Ce sont les publicités qui gardent le plein de carburant gratuit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたに合った広告を表示するために使用します。広告のおかげで燃料補給を無料で提供できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 잘 맞는 광고를 보여드리기 위해 사용됩니다. 광고 덕분에 연료 보충이 무료로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite mostrar anúncios mais adequados a você. São os anúncios que mantêm a recarga de combustível grátis."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne permite să îți arătăm reclame mai potrivite. Reclamele țin reumplerea cu combustibil gratuită."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让我们为你展示更合适的广告。正是广告让燃料补给保持免费。"
          }
        }
      }
    }
  },
  "version" : "1.0"
