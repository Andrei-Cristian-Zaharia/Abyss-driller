    "Lava can't burn you, frost can't chill" : {
      "comment" : "Perk description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lava brennt nicht, Frost kühlt nicht"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lava no te quema, la escarcha no te congela"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lave ne te brûle pas, le gel ne te glace pas"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "溶岩でも炎上せず、冷気でも凍えない"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "용암에 화상 없음, 서리에 냉기 없음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lava não te queima, gelo não te congela"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lava nu te arde, gerul nu te îngheață"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免疫熔岩灼烧和冰霜冻结"
          }
        }
      }
    },
    "Lies perfectly still with a glowing lure that looks exactly like pearl ore." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liegt völlig still mit einem leuchtenden Köder, der genau wie Perlenerz aussieht."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se queda quietecito con un señuelo brillante idéntico al mineral de perla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reste parfaitement immobile avec un leurre lumineux qui ressemble trait pour trait à du minerai de perle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "真珠の鉱石そっくりの光る誘い玉を下げて、じっと潜んでいる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진주 광석과 똑같이 생긴 빛나는 미끼를 달고 꼼짝 않고 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fica imóvel com uma isca brilhante idêntica a minério de pérola."
