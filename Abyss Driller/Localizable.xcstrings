    "Drag your thumb to turn the drill in any direction, even back up. You can change the sensitivity in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh mit dem Daumen, um den Bohrer in jede Richtung zu drehen, sogar nach oben. Die Empfindlichkeit kannst du in den Einstellungen ändern."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra el pulgar para girar el taladro en cualquier dirección, incluso hacia arriba. Puedes cambiar la sensibilidad en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fais glisser ton pouce pour tourner la foreuse dans n'importe quelle direction, même vers le haut. Tu peux régler la sensibilité dans les Réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指をドラッグすると、ドリルを好きな方向に向けられます。上にも戻れます。感度は設定で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "엄지를 드래그해 드릴을 어느 방향으로든 돌리세요. 위로도 갈 수 있어요. 감도는 설정에서 바꿀 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste o dedo para virar a broca em qualquer direção, até para cima. Você pode mudar a sensibilidade nos Ajustes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trage cu degetul ca să întorci foreza în orice direcție, chiar și înapoi în sus. Poți schimba sensibilitatea din Setări."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动拇指可让钻机朝任意方向转，甚至往回钻。灵敏度可在设置中调整。"
          }
        }
      }
    },
