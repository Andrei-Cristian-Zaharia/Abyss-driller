    "Keep your bit toward it: it blocks shards and lands hits in the same move." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halt den Bohrkopf auf ihn gerichtet: So blockst du Splitter und triffst in einem Zug."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén tu broca hacia él: bloquea esquirlas y le pega en el mismo movimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde ton foret tourné vers lui : il pare les éclats et frappe d'un même geste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビットを向け続けよう。結晶を防ぎつつ攻撃もできる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비트를 계속 보스 쪽으로 향하세요. 파편을 막으면서 동시에 공격도 돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha a broca virada para ele: ela bloqueia fragmentos e acerta golpes no mesmo movimento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ține vârful spre el: blochează cioburile și lovește în aceeași mișcare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "钻头始终对准它：既能挡晶刺，又能顺手命中。"
          }
        }
      }
    },
    "Kills, chests and boss rewards are coins: they never take space in the hold." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kills, Truhen und Boss-Belohnungen sind Münzen: Sie belegen nie Platz im Laderaum."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las muertes, los cofres y las recompensas de jefe son monedas: nunca ocupan espacio en la bodega."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éliminations, coffres et récompenses de boss sont des écus : ils ne prennent jamais de place en soute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撃破、宝箱、ボスの報酬はコインなので、カーゴの枠を使いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처치, 상자, 보스 보상은 코인이에요. 화물칸 자리를 차지하지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abates, baús e recompensas de chefe são moedas: nunca ocupam espaço no porão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uciderile, cuferele și recompensele de la șefi sunt monede: nu ocupă niciodată loc în cală."
