    "Re-downloads Double Gold, Remove Ads, the Mega Bundle and paint jobs you already bought" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt Doppelgold, Werbefrei, das Mega-Paket und bereits gekaufte Lackierungen erneut"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a descargar Oro doble, Quitar anuncios, el Megapaquete y las pinturas que ya compraste"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retélécharge l'Or doublé, Sans pub, le Méga pack et les peintures déjà achetés"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入済みのゴールド2倍、広告削除、メガパック、ペイントを復元します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 구매한 골드 2배, 광고 제거, 메가 번들, 도색을 다시 받아요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa de novo Ouro em Dobro, Remover Anúncios, o Megapacote e as pinturas que você já comprou"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redescarcă Aur dublu, Fără reclame, Megapachetul și vopselele pe care le-ai cumpărat deja"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新获取已购买的双倍金币、移除广告、超级礼包和涂装"
          }
        }
      }
    },
    "Reach a combo of %lld and Overdrive fires for a few seconds: faster, no fuel burn, and you smash through everything, even spiky geodes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erreiche eine Combo von %lld, und Overdrive zündet für ein paar Sekunden: schneller, kein Spritverbrauch, und du zertrümmerst alles, sogar Stachelgeoden."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llega a un combo de %lld y el Turbo se activa por unos segundos: más velocidad, sin gastar combustible, y lo rompes todo, hasta las geodas con picos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atteins un combo de %lld et le Surrégime s'enclenche quelques secondes : plus rapide, sans consommation, et tu brises tout, même les géodes à pointes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンボが%lldに達すると数秒間オーバードライブ発動。速度アップ、燃料消費なし、トゲジオードも含めて何でも砕けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "콤보 %lld에 도달하면 몇 초간 오버드라이브 발동! 더 빠르고, 연료가 안 들고, 가시 정동석까지 모든 걸 부숴요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chegue a um combo de %lld e o Turbo dispara por alguns segundos: mais rápido, sem gastar combustível, e você esmaga tudo, até geodos espinhosos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajungi la combo %lld și Turbo pornește câteva secunde: ești mai rapid, nu consumi combustibil și spargi tot, chiar și geodele cu țepi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连击达到%lld即触发数秒超载：速度更快、不耗燃料，一路横冲直撞，连尖刺晶石都能粉碎！"
          }
        }
      }
    },
