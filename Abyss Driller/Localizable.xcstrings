    "Spend gold in the Workshop on permanent upgrades, and fit parts in the Garage." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib Gold in der Werkstatt für dauerhafte Upgrades aus und bau Teile in der Garage ein."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gasta oro en el Taller en mejoras permanentes e instala piezas en el Garaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dépense ton or à l'Atelier en améliorations permanentes, et installe des pièces au Garage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工房でゴールドを使って永久強化し、ガレージでパーツを装着しよう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업장에서 골드로 영구 강화를 하고, 차고에서 부품을 장착하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaste ouro na Oficina com melhorias permanentes e instale peças na Garagem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheltuie aurul în Atelier pe îmbunătățiri permanente și montează piese în Garaj."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在工坊花金币购买永久升级，在车库安装部件。"
          }
        }
      }
    },
