    "Watch for the marked lanes and step out before they erupt. Heat Shield makes you immune." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achte auf die markierten Bahnen und tritt heraus, bevor sie ausbrechen. Mit dem Hitzeschild bist du immun."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fíjate en los carriles marcados y sal antes de que hagan erupción. El Escudo Térmico te hace inmune."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repère les couloirs marqués et sors-en avant qu'ils n'entrent en éruption. Le Bouclier thermique t'immunise."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "印の付いた列に注意し、噴き出す前に離れよう。耐熱シールドで無効化。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "표시된 줄을 잘 보고 분출 전에 빠져나오세요. 열 차폐막이 있으면 면역이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique de olho nas faixas marcadas e saia antes que entrem em erupção. O Escudo Térmico te deixa imune."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urmărește culoarele marcate și ieși din ele înainte să erupă. Scutul termic te face imun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意被标记的通道，在喷发前离开。装备隔热盾可免疫。"
          }
        }
      }
    },
    "What did you expect to happen?" : {
      "comment" : "Bug report email question",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was hast du erwartet?"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué esperabas que pasara?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que pensais-tu qu'il allait se passer ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本来はどうなるはずでしたか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원래 어떻게 될 줄 알았나요?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que você esperava que acontecesse?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce te așteptai să se întâmple?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你原本期望发生什么？"
          }
        }
      }
    },
    "What happened?" : {
      "comment" : "Bug report email question",
      "localizations" : {
        "de" : {
