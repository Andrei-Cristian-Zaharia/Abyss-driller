    "Dig as deep as you can. The run ends when you run out of fuel or armour. Everything you carry is sold at the end." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grab so tief du kannst. Die Runde endet, wenn dir Sprit oder Panzerung ausgehen. Alles, was du dabeihast, wird am Ende verkauft."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfora lo más hondo que puedas. La partida termina cuando te quedas sin combustible o sin blindaje. Todo lo que cargas se vende al final."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creuse aussi profond que possible. La partie se termine quand tu n'as plus de carburant ou de blindage. Tout ce que tu transportes est vendu à la fin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "できるだけ深く掘り進もう。燃料か装甲が尽きるとプレイ終了。持っているものは最後にすべて売却されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대한 깊이 파고드세요. 연료나 장갑이 다 떨어지면 판이 끝나요. 실은 것은 끝날 때 모두 팔려요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cave o mais fundo que puder. A partida acaba quando o combustível ou a blindagem acabam. Tudo o que você carrega é vendido no final."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sapă cât poți de adânc. Tura se termină când rămâi fără combustibil sau blindaj. Tot ce cari se vinde la final."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尽可能往深处钻！燃料或护甲耗尽时本局结束，携带的所有矿石会在结束时卖掉。"
          }
        }
      }
    },
