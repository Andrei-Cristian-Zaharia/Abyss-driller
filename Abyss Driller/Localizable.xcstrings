    "Hangs in the shallow caves, bobbing along its favourite tunnel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hängt in den flachen Höhlen und schaukelt durch ihren Lieblingstunnel."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuelga en las cuevas someras, meciéndose por su túnel favorito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traîne dans les grottes hautes, voletant le long de son tunnel préféré."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浅い洞窟に住み、お気に入りのトンネルをふわふわ漂う。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "얕은 동굴에 매달려 좋아하는 굴을 따라 둥실둥실 다녀요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fica pendurado nas cavernas rasas, balançando pelo seu túnel favorito."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atârnă în peșterile de sus, legănându-se de-a lungul tunelului preferat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "栖息在浅层洞穴，沿着最爱的隧道飞来飞去。"
          }
        }
      }
    },
    "Hangs on a silk line from the cave roof, waiting for something to pass underneath." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hängt an einem Seidenfaden von der Höhlendecke und wartet, dass etwas unten vorbeikommt."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuelga de un hilo de seda del techo de la cueva, esperando a que algo pase por debajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pend à un fil de soie au plafond de la grotte, attendant qu'une proie passe dessous."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "洞窟の天井から糸でぶら下がり、下を通る獲物を待ち構えている。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동굴 천장에서 거미줄에 매달려 아래로 지나가는 걸 기다려요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fica pendurada num fio de seda no teto da caverna, esperando algo passar por baixo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atârnă de un fir de mătase din tavanul peșterii, așteptând să treacă ceva pe dedesubt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吊在洞顶的蛛丝上，等着有东西从下面经过。"
          }
        }
      }
    },
