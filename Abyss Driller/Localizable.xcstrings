    "Frozen Depths. Slows the drill and its turning for a moment. Frost Runners make you immune." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eisige Tiefen. Verlangsamt Bohrer und Lenkung kurz. Mit Frostkufen bist du immun."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profundidades Heladas. Frena el taladro y sus giros por un momento. Los Patines de Escarcha te hacen inmune."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profondeurs gelées. Ralentit la foreuse et ses virages pendant un instant. Les Patins de givre t'immunisent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "凍てつく深層。少しの間ドリルの速度と旋回が鈍ります。雪原ソリで無効化。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빙결 지하. 잠시 동안 드릴 속도와 회전이 느려져요. 서리 썰매날이 있으면 면역이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profundezas Congeladas. Deixa a broca e as curvas lentas por um instante. As Lâminas de Gelo te deixam imune."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adâncurile Înghețate. Încetinește foreza și virajele pentru o clipă. Patinele de ger te fac imun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冰封地底。短暂降低钻机速度和转向。装备冰原滑轨可免疫。"
          }
        }
      }
    },
    "Frozen to the spot for a thousand years, and still in a bad mood about it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit tausend Jahren festgefroren und immer noch schlecht gelaunt deswegen."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Congelado en el mismo lugar por mil años, y todavía de malas por eso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Figé sur place depuis mille ans, et toujours de mauvaise humeur à ce sujet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "千年間その場で凍りついたまま。いまだにご機嫌ななめ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "천 년 동안 그 자리에 얼어붙어 있었고, 아직도 그게 불만이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Congelado no lugar há mil anos, e ainda de mau humor por causa disso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înghețat pe loc de o mie de ani și tot prost dispus din cauza asta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被冻在原地一千年了，至今还在生闷气。"
          }
        }
      }
    },
