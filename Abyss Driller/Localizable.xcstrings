    "%@. Each one is worth more than the last." : {
      "comment" : "Starts with the list of ore names",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Jedes ist mehr wert als das vorige."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Cada uno vale más que el anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Chacun vaut plus que le précédent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。後のものほど高く売れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. 뒤로 갈수록 더 비싸요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Cada um vale mais que o anterior."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Fiecare valorează mai mult decât precedentul."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。越往后越值钱！"
          }
        }
      }
    },
    "%@. Shop parts get rarer as they get pricier; every boss part is Legendary." : {
      "comment" : "Starts with the rarity names, lowest to highest",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Shop-Teile werden mit dem Preis seltener; jedes Boss-Teil ist Legendär."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Las piezas de la tienda son más raras entre más caras; toda pieza de jefe es Legendaria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Plus une pièce de boutique est chère, plus elle est rare ; chaque pièce de boss est Légendaire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。ショップのパーツは高いほどレア度が上がり、ボスパーツはすべてレジェンドです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. 상점 부품은 비쌀수록 희귀하고, 보스 부품은 모두 전설이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. As peças da loja ficam mais raras conforme ficam mais caras; toda peça de chefe é Lendária."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Piesele din magazin sunt mai rare cu cât sunt mai scumpe; toate piesele de șef sunt Legendare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。商店部件越贵越稀有，BOSS部件全是传说级！"
          }
        }
      }
    },
