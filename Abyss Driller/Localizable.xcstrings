    "How far your thumb must move before the drill turns. Raise it if small wobbles steer you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie weit sich dein Daumen bewegen muss, bevor der Bohrer dreht. Erhöhe sie, wenn kleines Wackeln dich lenkt."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto debe moverse tu pulgar antes de que gire el taladro. Súbelo si los temblores pequeños te desvían."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance que ton pouce doit parcourir avant que la foreuse tourne. Augmente-la si les petits tremblements te font dévier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドリルが向きを変えるまでに必要な指の移動距離。指のブレで動いてしまう場合は上げてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드릴이 돌기 전에 엄지가 움직여야 하는 거리예요. 작은 흔들림에도 방향이 바뀌면 높이세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto seu dedo precisa se mover antes de a broca virar. Aumente se pequenos tremores estiverem te guiando."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cât trebuie să-ți miști degetul până se întoarce foreza. Mărește-o dacă te deviază micile tremurături."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拇指移动多远钻机才转向。如果轻微晃动就会误转，请调高。"
          }
        }
      }
    },
    "How fast the drill turns toward your thumb." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie schnell der Bohrer sich zu deinem Daumen dreht."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué tan rápido gira el taladro hacia tu pulgar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitesse à laquelle la foreuse tourne vers ton pouce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指の方向へドリルが向きを変える速さ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드릴이 엄지 쪽으로 도는 속도예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A velocidade com que a broca vira na direção do seu dedo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cât de repede se întoarce foreza spre degetul tău."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "钻机转向拇指方向的速度。"
          }
        }
      }
    },
