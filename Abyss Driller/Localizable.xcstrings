    "Spore Hollow. Your fuel leaks out %@× faster for a few seconds. The Spore Filter makes you immune." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sporensenke. Dein Sprit läuft ein paar Sekunden lang %@× schneller aus. Mit dem Sporenfilter bist du immun."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hondonada de Esporas. Tu combustible se fuga %@× más rápido por unos segundos. El Filtro de Esporas te hace inmune."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creux des spores. Ton carburant fuit %@× plus vite pendant quelques secondes. Le Filtre à spores t'immunise."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "胞子の窪地。数秒間、燃料が%@×の速さで漏れます。胞子フィルターで無効化。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포자 골짜기. 몇 초 동안 연료가 %@× 빠르게 새요. 포자 필터가 있으면 면역이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grota dos Esporos. Seu combustível vaza %@× mais rápido por alguns segundos. O Filtro de Esporos te deixa imune."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorbura Sporilor. Combustibilul se scurge de %@× mai repede câteva secunde. Filtrul de spori te face imun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "孢子洞。数秒内燃料泄漏速度×%@。装备孢子滤网可免疫。"
          }
        }
      }
    },
    "Spore Puff" : {
      "comment" : "Field Guide creature name",
      "localizations" : {
