        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光るものに跳ねて寄ってくる生きた結晶ゼリー。あなたのドリルはとても光っている。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "반짝이는 걸 향해 통통 튀는 살아 있는 수정 젤리. 당신의 드릴은 아주 반짝여요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gosma de cristal viva que pula atrás de qualquer coisa brilhante. Sua broca é muito brilhante."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mâzgă vie de cristal care țopăie spre orice strălucește. Foreza ta strălucește tare de tot."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会蹦的活体水晶黏液，专找亮闪闪的东西。你的钻机就很亮。"
          }
        }
      }
    },
