    "Upgrade %@ to Mark %lld: %@. Costs %lld gold and %lld boss cores." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ auf Mark %2$lld verbessern: %3$@. Kostet %4$lld Gold und %5$lld Boss-Kerne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Upgrade %1$@ to Mark %2$lld: %3$@. Costs %4$lld gold and %5$lld boss cores."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejorar %@ a Mk %lld: %@. Cuesta %lld de oro y %lld núcleos de jefe."
          }
