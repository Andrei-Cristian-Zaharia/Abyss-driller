    "Rules the shallow caves from the ceiling, with a swarm always on call." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herrscht von der Decke aus über die flachen Höhlen, mit einem Schwarm stets auf Abruf."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gobierna las cuevas someras desde el techo, con un enjambre siempre listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Règne sur les grottes hautes depuis le plafond, avec une nuée toujours prête."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天井から浅い洞窟を支配し、いつでも群れを呼び寄せる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
