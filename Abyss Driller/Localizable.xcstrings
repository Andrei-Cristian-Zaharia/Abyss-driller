    "Hidden in caves just past your best depth. Drill into one for a big payout." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versteckt in Höhlen knapp unter deiner Rekordtiefe. Bohr hinein für eine fette Belohnung."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escondidas en cuevas justo después de tu mejor profundidad. Perfora una para ganar un premio grande."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cachés dans des grottes juste après ton record de profondeur. Fore dedans pour un gros butin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最高深度を少し超えた洞窟に隠されています。掘り当てれば大もうけ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최고 깊이 바로 아래 동굴에 숨어 있어요. 뚫고 들어가면 큰 보상이 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escondidas em cavernas logo depois da sua maior profundidade. Perfure uma para um prêmio enorme."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascunse în peșteri chiar dincolo de adâncimea ta record. Sapă într-una pentru o recompensă mare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "藏在略深于你最佳深度的洞穴里。钻进去就能大赚一笔！"
          }
        }
      }
    },
    "Hit it from behind, or right after it slams into a wall and is dazed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Triff ihn von hinten oder direkt, nachdem er gegen eine Wand kracht und benommen ist."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pégale por detrás, o justo después de que choque contra una pared y quede aturdido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frappe-le par derrière, ou juste après qu'il a percuté un mur et qu'il est sonné."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背後から攻撃するか、壁に激突してフラフラしているところを狙おう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "뒤에서 치거나, 벽에 부딪혀 기절했을 때 바로 치세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acerte por trás, ou logo depois que ele bater numa parede e ficar tonto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lovește-l din spate sau imediat după ce se izbește de un perete și rămâne amețit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从背后打它，或趁它撞墙晕眩时出手。"
          }
        }
      }
    },
    "Hold anywhere to dig. Let go to stop and keep your fuel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte irgendwo zum Graben. Lass los, um zu stoppen und Sprit zu sparen."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionado en cualquier lugar para excavar. Suelta para frenar y ahorrar combustible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintiens n'importe où pour creuser. Relâche pour t'arrêter et garder ton carburant."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どこでも長押しで掘削。指を離すと停止して燃料を節約できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무 곳이나 길게 눌러 파요. 손을 떼면 멈추고 연료를 아껴요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure em qualquer lugar para cavar. Solte para parar e poupar combustível."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ține apăsat oriunde ca să sapi. Ia degetul ca să te oprești și să economisești combustibil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住任意位置开钻，松手停下以节省燃料。"
          }
        }
      }
    },
    "Hold filled up — a bigger hold sells for more" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laderaum voll – ein größerer Laderaum bringt mehr"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bodega llena: una bodega más grande vende más"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soute pleine : une plus grande soute rapporte plus"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カーゴが満杯！大きいカーゴほど高く売れる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화물칸 가득 — 큰 화물칸일수록 더 많이 팔려요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porão lotado — um porão maior vende mais"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cala s-a umplut — o cală mai mare se vinde pe mai mult"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "货舱满了——货舱越大卖得越多"
          }
        }
      }
    },
    "Hold to drill" : {
      "localizations" : {
        "de" : {
