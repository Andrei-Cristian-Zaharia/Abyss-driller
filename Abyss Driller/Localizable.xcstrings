    "Mind the puddles it leaves behind. A Heat Shield makes them harmless." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achte auf die Pfützen, die sie hinterlässt. Ein Hitzeschild macht sie harmlos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuidado con los charcos que deja. Un Escudo Térmico los vuelve inofensivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gare aux flaques qu'elle laisse derrière elle. Un Bouclier thermique les rend inoffensives."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通った跡の溶岩だまりに注意。耐熱シールドがあれば無害です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "남기고 간 웅덩이를 조심하세요. 열 차폐막이 있으면 무해해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuidado com as poças que ele deixa pra trás. Um Escudo Térmico deixa elas inofensivas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai grijă la bălțile pe care le lasă în urmă. Un Scut termic le face inofensive."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小心它留下的熔岩坑。装备隔热盾就无害了。"
          }
        }
      }
    },
