    "Popping a big one splits it into two little ones. Be ready to pop those too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platzt ein großer, teilt er sich in zwei kleine. Sei bereit, die auch abzuknallen."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al reventar uno grande se divide en dos chiquitos. Prepárate para reventar esos también."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éclater une grosse la divise en deux petites. Prépare-toi à les éclater aussi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きいのを割ると小さい2匹に分裂。そっちも割る準備をしておこう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "큰 걸 터뜨리면 작은 두 마리로 갈라져요. 그것도 터뜨릴 준비를 하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estourar um grande divide ele em dois pequenos. Esteja pronto para estourar esses também."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă spargi una mare, se împarte în două mici. Fii gata să le spargi și pe ele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "戳爆大的会分裂成两个小的，准备好接着戳！"
          }
        }
      }
    },
