    "Grows amber crystals on its back and flings them at anything that moves." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt Bernsteinkristalle auf dem Rücken wachsen und schleudert sie auf alles, was sich bewegt."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le crecen cristales ámbar en la espalda y se los avienta a todo lo que se mueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait pousser des cristaux d'ambre sur son dos et les lance sur tout ce qui bouge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背中に琥珀色の結晶を生やし、動くものに投げつけてくる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "등에 호박색 수정을 키워서 움직이는 건 뭐든 던져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cria cristais âmbar nas costas e atira eles em qualquer coisa que se mexa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Își crește cristale de chihlimbar pe spate și le aruncă în orice se mișcă."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背上长着琥珀色晶体，见到会动的就往外甩。"
          }
        }
      }
    },
