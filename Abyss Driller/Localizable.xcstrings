    "Each boss has 3 powers. The third joins when it's enraged at half health. Every power is warned first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Boss hat 3 Kräfte. Die dritte kommt dazu, wenn er bei halben Lebenspunkten rasend wird. Jede Kraft wird vorher angekündigt."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada jefe tiene 3 poderes. El tercero se suma cuando se enfurece a media salud. Todos los poderes se avisan antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque boss a 3 pouvoirs. Le troisième s'ajoute quand il entre en furie à mi-vie. Chaque pouvoir est annoncé à l'avance."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボスは3つの技を持ち、3つ目は体力が半分になり激怒すると使い始めます。どの技も事前に予告があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보스마다 기술이 3개 있어요. 세 번째 기술은 체력이 절반일 때 분노하며 추가돼요. 모든 기술은 미리 경고돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada chefe tem 3 poderes. O terceiro entra quando ele fica enfurecido com metade da vida. Todo poder é avisado antes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare șef are 3 puteri. A treia apare când se înfurie, la jumătate de viață. Fiecare putere e semnalată dinainte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个BOSS有3种技能，第三种在半血狂暴时加入。每种技能释放前都有预警。"
          }
        }
      }
    },
