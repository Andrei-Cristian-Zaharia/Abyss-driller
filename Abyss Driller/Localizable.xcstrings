    "Watch a short ad for one more upgrade, free." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh dir kurz Werbung an für ein weiteres Upgrade, gratis."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve un anuncio corto para obtener otra mejora gratis."
          }
        },
