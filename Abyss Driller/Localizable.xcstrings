    "An armoured scuttler that patrols one row of the deep caves, back and forth, forever." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein gepanzerter Krabbler, der in den tiefen Höhlen eine Reihe abläuft, hin und her, für immer."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bicho acorazado que patrulla una fila de las cuevas profundas, de ida y vuelta, para siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un trotteur cuirassé qui patrouille une rangée des grottes profondes, aller-retour, pour l'éternité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深い洞窟の一列をひたすら行ったり来たりする装甲ムシ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "깊은 동굴의 한 줄을 영원히 왔다 갔다 순찰하는 장갑 벌레예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um bicho blindado que patrulha uma fileira das cavernas profundas, pra lá e pra cá, para sempre."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un târâtor blindat care patrulează un singur rând din peșterile adânci, înainte și înapoi, la nesfârșit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "披甲的爬虫，在深层洞穴的一排里来回巡逻，永不停歇。"
          }
        }
      }
    },
    "An ice serpent coiled around the coldest place on Earth. Its breath freezes rock solid." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Eisschlange, zusammengerollt um den kältesten Ort der Erde. Ihr Atem lässt Fels gefrieren."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una serpiente de hielo enroscada en el lugar más frío de la Tierra. Su aliento congela la roca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un serpent de glace enroulé autour de l'endroit le plus froid de la Terre. Son souffle gèle la roche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地球で最も寒い場所にとぐろを巻く氷の大蛇。その息は岩をも凍らせる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지구에서 가장 추운 곳을 휘감은 얼음 뱀. 숨결 한 번에 바위도 꽁꽁 얼어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma serpente de gelo enrolada no lugar mais frio da Terra. Seu sopro congela a rocha."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un șarpe de gheață încolăcit în jurul celui mai rece loc de pe Pământ. Suflarea lui îngheață piatra bocnă."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "盘踞在地球最冷之处的冰蛇，一口吐息就能把岩石冻透。"
          }
        }
      }
    },
