    "Beat a boss once and it comes back as a mini: smaller, half the health, a bit faster." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besiegst du einen Boss, kehrt er als Mini zurück: kleiner, halbe Lebenspunkte, etwas schneller."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derrota a un jefe una vez y regresa como mini: más chico, con la mitad de salud y un poco más rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bats un boss une fois et il revient en version mini : plus petit, deux fois moins de PV, un peu plus rapide."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度倒したボスはミニボスとして再登場。小さく、体力半分で、少し速くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 쓰러뜨린 보스는 미니로 돌아와요. 더 작고, 체력은 절반, 조금 더 빨라요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derrote um chefe uma vez e ele volta como mini: menor, com metade da vida e um pouco mais rápido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Învinge un șef o dată și se întoarce ca mini-șef: mai mic, cu jumătate de viață și puțin mai rapid."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "击败BOSS一次后，它会以迷你形态回归：体型更小、血量减半、速度稍快。"
          }
        }
      }
    },
