    "Fat, patient and fond of shiny things. Its tongue is longer than it looks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fett, geduldig und vernarrt in glänzende Dinge. Ihre Zunge ist länger, als sie aussieht."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gordo, paciente y fan de las cosas brillantes. Su lengua es más larga de lo que parece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gros, patient et amateur de choses brillantes. Sa langue est plus longue qu'il n'y paraît."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太っちょで気長、光るものが大好き。舌は見た目よりずっと長い。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "뚱뚱하고 참을성 많고 반짝이는 걸 좋아해요. 혀는 보기보다 길어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gordo, paciente e fã de coisas brilhantes. A língua dele é mais comprida do que parece."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gras, răbdător și pasionat de lucruri strălucitoare. Limba lui e mai lungă decât pare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "又胖又有耐心，最爱亮晶晶的东西。舌头比看上去长得多。"
          }
        }
      }
    },
