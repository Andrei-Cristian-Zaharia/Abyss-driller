    "Never drillable and cost 2 armour. Only Overdrive or the Diamond Bit perk breaks them (they look cracked when you can)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie bohrbar, kosten 2 Panzerung. Nur Overdrive oder das Diamantkopf-Perk zerbricht sie (sie sehen rissig aus, wenn du kannst)."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca se pueden perforar y cuestan 2 de blindaje. Solo el Turbo o la ventaja Broca de Diamante las rompen (se ven agrietadas cuando puedes)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibles à forer, elles coûtent 2 de blindage. Seuls le Surrégime ou l'atout Foret diamant les brisent (elles paraissent fissurées quand c'est possible)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掘れず、当たると装甲が2減ります。壊せるのはオーバードライブかパーク「ダイヤビット」だけ（壊せるときはヒビが入って見えます）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "절대 뚫을 수 없고 장갑이 2 줄어요. 오버드라이브나 다이아 비트 특성으로만 부술 수 있어요(부술 수 있으면 금이 가 보여요)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca podem ser perfurados e custam 2 de blindagem. Só o Turbo ou a vantagem Broca de Diamante quebram eles (eles aparecem rachados quando dá)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu pot fi săpate niciodată și costă 2 blindaj. Doar Turbo sau atuul Vârf de diamant le sparge (par crăpate când poți)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永远钻不动，碰到扣2点护甲。只有超载或“钻石钻头”天赋能击碎（可击碎时会显示裂纹）。"
          }
        }
      }
    },
