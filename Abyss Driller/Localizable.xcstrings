    "Only your headlight shows. Gems still glint. The Abyss Lantern keeps the lights on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur dein Scheinwerfer leuchtet. Juwelen funkeln trotzdem. Die Abgrundlaterne lässt das Licht an."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se ve tu faro. Las gemas siguen brillando. El Farol Abisal mantiene la luz encendida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul ton phare éclaire. Les gemmes brillent toujours. La Lanterne abyssale garde la lumière allumée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見えるのはヘッドライトの光だけ。宝石は暗くても光ります。深淵ランタンがあれば明るいまま。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "헤드라이트만 비춰요. 보석은 여전히 반짝여요. 심연 랜턴이 있으면 계속 밝아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só o seu farol ilumina. As gemas ainda brilham. A Lanterna Abissal mantém as luzes acesas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vede doar farul tău. Nestematele tot sclipesc. Felinarul Abisului ține luminile aprinse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有车头灯能照亮，宝石依然闪光。深渊明灯能让灯一直亮着。"
          }
        }
      }
    },
    "Opens an email to the developer with your device details filled in" : {
