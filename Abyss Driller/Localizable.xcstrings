    "One bit, hull, tracks and module at a time. Parts are trade-offs: pick a build that suits you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ein Bohrkopf, Rumpf, Ketten und Modul. Teile sind Kompromisse: Wähl einen Build, der zu dir passt."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una broca, un casco, unas orugas y un módulo a la vez. Las piezas tienen pros y contras: arma la combinación que te acomode."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un foret, une coque, des chenilles et un module à la fois. Chaque pièce est un compromis : choisis la config qui te va."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビット、ボディ、キャタピラ、モジュールを1つずつ装着できます。パーツには一長一短があるので、自分に合った組み合わせを選ぼう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비트, 차체, 트랙, 모듈을 하나씩 장착해요. 부품마다 장단점이 있으니 나에게 맞는 조합을 고르세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma broca, um casco, uma esteira e um módulo por vez. Peças têm prós e contras: escolha uma montagem que combine com você."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Câte un vârf, o carcasă, un set de șenile și un modul o dată. Piesele vin cu compromisuri: alege un build care ți se potrivește."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "钻头、机身、履带和模块各装一件。部件各有取舍：选一套适合你的配置！"
          }
        }
      }
    },
