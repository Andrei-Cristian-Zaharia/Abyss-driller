    "Skim past a rock you can't break without touching it: \"CLOSE!\" gives fuel and combo." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streif knapp an einem Fels vorbei, den du nicht brechen kannst, ohne ihn zu berühren: „KNAPP!“ gibt Sprit und Combo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa rozando una roca que no puedes romper sin tocarla: \"¡POR POCO!\" da combustible y combo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frôle une roche incassable sans la toucher : « FRÔLÉ ! » donne du carburant et du combo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壊せない岩のすれすれを通り抜けると「ニアミス！」。燃料とコンボを獲得。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "깰 수 없는 바위를 닿지 않고 스쳐 지나가세요. “아슬아슬!”이 뜨면 연료와 콤보를 얻어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe raspando por uma rocha que você não consegue quebrar, sem encostar: \"RASPOU!\" dá combustível e combo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treci razant pe lângă o rocă pe care n-o poți sparge, fără s-o atingi: „LA MUSTAȚĂ!” îți dă combustibil și combo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "贴着钻不动的岩石擦过但别碰到：“擦边！”可获得燃料和连击。"
          }
        }
      }
    },
    "Skip every ad, still get the reward" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überspring jede Werbung, Belohnung gibt's trotzdem"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sáltate todos los anuncios y recibe la recompensa igual"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zappe chaque pub, garde la récompense"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広告なしで報酬GET"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "광고 없이 보상 받기"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pule todos os anúncios e ganhe a recompensa mesmo assim"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sari peste orice reclamă și primești oricum recompensa"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳过所有广告，奖励照拿"
          }
        }
      }
    },
    "Sleeps in the topsoil until a drill rumbles past, then wakes up hungry and gives chase." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schläft im Mutterboden, bis ein Bohrer vorbeirumpelt, wacht dann hungrig auf und nimmt die Jagd auf."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duerme en la tierra hasta que pasa un taladro retumbando; entonces despierta con hambre y te persigue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dort sous la surface jusqu'au passage d'une foreuse, puis se réveille affamé et la prend en chasse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドリルが近くを通るまで表土で眠り、目覚めると腹ペコで追いかけてくる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드릴 소리가 들릴 때까지 표토에서 자다가, 깨면 배고파서 쫓아와요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorme na terra até uma broca passar roncando, aí acorda com fome e sai em perseguição."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doarme în pământ până trece o foreză pe lângă, apoi se trezește flămând și pornește după ea."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在表土里睡大觉，直到钻机隆隆经过，才饿醒并紧追不放。"
          }
        }
      }
    },
    "Slip between the spiral arms or block them. Stay clear of the black hole. When it blinks, watch the ring: that's where it will be." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlüpf zwischen den Spiralarmen durch oder blocke sie. Halte Abstand vom Schwarzen Loch. Wenn er teleportiert, achte auf den Ring: Dort taucht er auf."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pásate entre los brazos de la espiral o bloquéalos. Aléjate del agujero negro. Cuando parpadee, fíjate en el anillo: ahí es donde aparecerá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faufile-toi entre les bras de la spirale ou pare-les. Reste loin du trou noir. Quand il cligne, regarde l'anneau : c'est là qu'il apparaîtra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "渦の腕のすき間をすり抜けるか、ブロックしよう。ブラックホールには近づかないこと。瞬間移動するときはリングを見よう。そこに現れる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나선 팔 사이로 빠져나가거나 막으세요. 블랙홀은 멀리하세요. 깜빡이면 고리를 보세요. 거기에 나타나요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe entre os braços da espiral ou bloqueie eles. Fique longe do buraco negro. Quando ele piscar, olhe o anel: é ali que ele vai aparecer."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strecoară-te printre brațele spiralei sau blochează-le. Stai departe de gaura neagră. Când se teleportează, urmărește inelul: acolo va apărea."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从螺旋臂之间钻过去，或者格挡。远离黑洞。它闪现时注意光圈：那就是它的落点。"
          }
        }
      }
    },
    "Slow, sticky and very hot. It leaves a trail of lava wherever it crawls." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsam, klebrig und sehr heiß. Hinterlässt überall, wo sie kriecht, eine Lavaspur."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lenta, pegajosa y muy caliente. Deja un rastro de lava por donde se arrastra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lente, collante et brûlante. Elle laisse une traînée de lave partout où elle rampe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "のろくてネバネバ、とっても熱い。はった跡に溶岩を残す。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "느리고 끈적하고 아주 뜨거워요. 기어간 자리에 용암을 남겨요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lenta, grudenta e muito quente. Deixa um rastro de lava por onde rasteja."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lent, lipicios și foarte fierbinte. Lasă o dâră de lavă oriunde se târăște."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "又慢、又黏、又烫，爬到哪儿就留下一路熔岩。"
          }
        }
      }
    },
    "Something wrapped in linen that drifts through solid stone after anything that moves." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas in Leinen Gewickeltes, das durch massiven Stein allem nachschwebt, was sich bewegt."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo envuelto en lino que flota a través de la piedra sólida tras todo lo que se mueve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une chose enveloppée de lin qui traverse la pierre à la poursuite de tout ce qui bouge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布に包まれた何か。動くものを追って岩の中をすり抜けてくる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아마포에 싸인 무언가. 단단한 돌을 통과해 움직이는 걸 쫓아다녀요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo enrolado em linho que atravessa pedra maciça atrás de qualquer coisa que se mexa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceva înfășurat în giulgiu, care plutește prin piatra solidă după orice se mișcă."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一团裹着亚麻布的东西，能穿过实心岩石追逐一切会动的东西。"
          }
        }
      }
    },
